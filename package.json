{
  "name": "eng-chat",
  "version": "1.2.0",
  "description": "VinaWrite — AI writing, rewriting and translation assistant for any text box",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:standalone": "vite --open standalone.html",
    "build": "tsc && vite build",
    "package": "tsc && vite build && cd dist && zip -r ../vinawrite.zip . -x '*.DS_Store'",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "happy-dom": "^14.12.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
